+/*
+=======================================================================
+
+PS5: SPLIT SCREEN
+
+Players 2 and on (as many as cl_splitPlayers asks for, up to
+MAX_LOCAL_PLAYERS) play on the local server beside player 1, each an ordinary
+client of it with a loopback channel of their own, a cgame of their own and a
+part of the screen. The cgame is the stock one: it is told its part of the
+screen is the whole screen, and what it draws is moved into its part.
+
+=======================================================================
+*/
+
+/*
+=====================
+CL_SetLocalPlayer
+
+Makes a local player the current one, whose cl, clc, cgvm and cls.state
+the client's code works with; returns the player that was current.
+=====================
+*/
+int CL_SetLocalPlayer( int player ) {
+	const int previous = cl_localPlayer;
+
+	if ( (unsigned)player >= MAX_LOCAL_PLAYERS || player == previous ) {
+		return previous;
+	}
+
+	cl_lp->state = cls.state;
+	cl_localPlayer = player;
+	cl_lp = &cl_localPlayers[ player ];
+	cls.state = cl_lp->state;
+
+	return previous;
+}
+
+
+/*
+=====================
+CL_PlayerState
+=====================
+*/
+connstate_t CL_PlayerState( int player ) {
+	return player == cl_localPlayer ? cls.state : cl_localPlayers[ player ].state;
+}
+
+
+/*
+=====================
+CL_SplitViews
+
+The parts of the screen, one for each local player: 1 without split screen
+(not on a local server, or cl_splitPlayers was 1 when its map started).
+=====================
+*/
+int CL_SplitViews( void ) {
+	const connstate_t state = CL_PlayerState( 0 );
+
+	if ( cl_views > 1 && state >= CA_CONNECTED && state != CA_CINEMATIC && com_sv_running && com_sv_running->integer ) {
+		return cl_views;
+	}
+
+	return 1;
+}
+
+
+/*
+=====================
+CL_PlayerView
+
+A player's part of the screen, in pixels. Two players have a half each, side
+by side, the whole height of the screen (each sees as far around as on a 4:3
+screen, and a little further up and down); three or four have a quarter each,
+players 1 and 2 at the top. A thin black line keeps the parts apart.
+=====================
+*/
+void CL_PlayerView( int player, int *x, int *y, int *width, int *height ) {
+	const int views = CL_SplitViews();
+	const int gap = views > 1 ? MAX( 2, cls.glconfig.vidHeight / 270 ) & ~1 : 0;
+
+	if ( views <= 1 ) {
+		*x = *y = 0;
+		*width = cls.glconfig.vidWidth;
+		*height = cls.glconfig.vidHeight;
+	} else if ( views == 2 ) {
+		*width = ( cls.glconfig.vidWidth - gap ) / 2;
+		*height = cls.glconfig.vidHeight;
+		*x = ( player & 1 ) * ( *width + gap );
+		*y = 0;
+	} else {
+		*width = ( cls.glconfig.vidWidth - gap ) / 2;
+		*height = ( cls.glconfig.vidHeight - gap ) / 2;
+		*x = ( player & 1 ) * ( *width + gap );
+		*y = ( player >> 1 ) * ( *height + gap );
+	}
+}
+
+
+/*
+=====================
+CL_PlayerPlaying
+
+A player with a part of the screen, in the game.
+=====================
+*/
+qboolean CL_PlayerPlaying( int player ) {
+	return player < CL_SplitViews() && CL_PlayerState( player ) == CA_ACTIVE;
+}
