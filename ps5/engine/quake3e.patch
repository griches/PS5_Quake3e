+/*
+=====================
+CL_SplitJoin
+
+A player after the first joins the local server (with player 1 current).
+=====================
+*/
+static void CL_SplitJoin( int player ) {
+	const int previous = CL_SetLocalPlayer( player );
+
+	CL_ClearState();
+	Com_Memset( &clc, 0, sizeof( clc ) );
+	cl_lp->loadPending = qfalse;
+	cl_lp->teamSent = qfalse;
+	cl_lp->userinfo[0] = '\0';
+
+	NET_StringToAdr( "localhost", &clc.serverAddress, NA_UNSPEC );
+	clc.serverAddress.port = player; // the player's loopback channel
+	cls.state = CA_CHALLENGING; // we don't need a challenge on the localhost
+	clc.connectTime = cls.realtime - RECONNECT_TIMEOUT; // send the connect now
+	CL_CheckForResend();
+
+	CL_SetLocalPlayer( previous );
+}
+
+
+/*
+=====================
+CL_SplitLeave
+
+A player after the first leaves the server.
+=====================
+*/
+static void CL_SplitLeave( int player ) {
+	const int previous = CL_SetLocalPlayer( player );
+
+	if ( cgvm ) {
+		CL_ShutdownCGame();
+	}
+
+	if ( cls.state >= CA_CONNECTED && cls.state != CA_CINEMATIC ) {
+		CL_AddReliableCommand( "disconnect", qtrue );
+		CL_WritePacket( 2 );
+	}
+
+	CL_ClearState();
+	Com_Memset( &clc, 0, sizeof( clc ) );
+	cls.state = CA_DISCONNECTED;
+	cl_lp->loadPending = qfalse;
+
+	CL_SetLocalPlayer( previous );
+}
+
+
+/*
+=====================
+CL_SplitSync
+
+Each frame, with player 1 current: the players after the first join the
+server while the screen has a part for them, and leave when it has none.
+=====================
+*/
+static void CL_SplitSync( void ) {
+	const int views = CL_SplitViews();
+	int player;
+
+	for ( player = 1; player < MAX_LOCAL_PLAYERS; player++ ) {
+		const localPlayer_t *lp = &cl_localPlayers[ player ];
+		if ( player < views && !lp->dropped ) {
+			if ( lp->state <= CA_DISCONNECTED ) {
+				CL_SplitJoin( player );
+			}
+		} else if ( lp->state > CA_DISCONNECTED ) {
+			CL_SplitLeave( player );
+		}
+	}
+}
+
+
+/*
+=====================
+CL_SplitLoad
+
+The current player, after the first, loads the map once player 1 has (the
+gamestate may come first: CL_ParseGamestate). Player 1's loading clears the
+client's memory; the others' use the world, the sounds and the pictures
+player 1's cgame loaded.
+=====================
+*/
+static void CL_SplitLoad( void ) {
+	const connstate_t first = CL_PlayerState( 0 );
+
+	if ( !cl_lp->loadPending || first < CA_PRIMED || first == CA_CINEMATIC ) {
+		return;
+	}
+
+	cl_lp->loadPending = qfalse;
+	if ( cgvm ) {
+		CL_ShutdownCGame(); // a gamestate again, on the same map
+	}
+	cls.state = CA_LOADING;
+	CL_InitCGame();
+	CL_SendPureChecksums();
+	CL_WritePacket( 2 );
+}
+
+
+/*
+=====================
+CL_ShutdownSplitCGames
+
+The cgames of the players after the first.
+=====================
+*/
+static void CL_ShutdownSplitCGames( void ) {
+	const int previous = cl_localPlayer;
+	int player;
+
+	for ( player = 1; player < MAX_LOCAL_PLAYERS; player++ ) {
+		if ( cl_localPlayers[ player ].cgame ) {
+			CL_SetLocalPlayer( player );
+			CL_ShutdownCGame();
+		}
+	}
+
+	CL_SetLocalPlayer( previous );
+}
+
+
+/*
+=====================
+CL_InitSplitCGames
+
+After vid_restart: the cgames of the players after the first that had one.
+=====================
+*/
+static void CL_InitSplitCGames( void ) {
+	const int previous = cl_localPlayer;
+	int player;
+
+	for ( player = 1; player < MAX_LOCAL_PLAYERS; player++ ) {
+		const connstate_t state = cl_localPlayers[ player ].state;
+		if ( state > CA_CONNECTED && state != CA_CINEMATIC ) {
+			CL_SetLocalPlayer( player );
+			CL_InitCGame();
+			CL_SendPureChecksums();
+		}
+	}
+
+	CL_SetLocalPlayer( previous );
+}
+
+
+/*
+=====================
+CL_SplitScores
+
+With player 1 current: three players leave a quarter of the screen to the
+scoreboard (cl_scrn.c), and player 1 asks the game for the scores once a
+second for it, as the game's own scoreboard does while it is shown.
+=====================
+*/
+static void CL_SplitScores( void ) {
+	static int next;
+
+	if ( CL_SplitViews() != 3 || cls.state != CA_ACTIVE || clc.demoplaying ) {
+		return;
+	}
+	if ( next - cls.realtime > 0 && next - cls.realtime <= 1000 ) {
+		return;
+	}
+	next = cls.realtime + 1000;
+	CL_AddReliableCommand( "score", qfalse );
+}
+
+
+/*
+=====================
+CL_PlayerPacketEvent
+
+A packet on a local player's loopback channel.
+=====================
+*/
+void CL_PlayerPacketEvent( int player, const netadr_t *from, msg_t *msg ) {
+	int previous;
+
+	if ( player == 0 && cl_localPlayer == 0 ) {
+		CL_PacketEvent( from, msg );
+		return;
+	}
+
+	previous = CL_SetLocalPlayer( player );
+	if ( player == 0 || cls.state > CA_DISCONNECTED ) {
+		CL_PacketEvent( from, msg );
+	}
+	CL_SetLocalPlayer( previous );
+}
+
+
+/*
+=====================
+CL_Player_f
+
+player <n> <command>: a command as player n, for the bindings of the players
+after the first (CL_PlayerKeyEvent), and for the console.
+=====================
+*/
+static void CL_Player_f( void ) {
+	char text[ MAX_STRING_CHARS ];
+	const char *s;
+	int player, previous, i;
+
+	if ( Cmd_Argc() < 3 ) {
+		Com_Printf( "usage: player <1-%i> <command>\n", MAX_LOCAL_PLAYERS );
+		return;
+	}
+
+	player = atoi( Cmd_Argv( 1 ) ) - 1;
+	if ( (unsigned)player >= MAX_LOCAL_PLAYERS ) {
+		Com_Printf( "No player %s\n", Cmd_Argv( 1 ) );
+		return;
+	}
+	if ( player >= CL_SplitViews() ) {
+		return; // not playing
+	}
+
+	// the command as it was written, after "player <n>"
+	s = Cmd_Cmd();
+	for ( i = 0; i < 2; i++ ) {
+		while ( *s == ' ' || *s == '\t' )
+			s++;
+		while ( *s && *s != ' ' && *s != '\t' )
+			s++;
+	}
+	while ( *s == ' ' || *s == '\t' )
+		s++;
+	Q_strncpyz( text, s, sizeof( text ) );
+
+	previous = CL_SetLocalPlayer( player );
+	Cmd_ExecuteString( text );
+	CL_SetLocalPlayer( previous );
+}
