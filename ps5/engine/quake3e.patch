+/*
+=====================
+CL_PlayerUserinfo
+
+The userinfo a local player sends: player 1's cvars, with cl_splitName<n> and
+cl_splitModel<n> for the others. A player without a name of their own is
+"Player <n>"; one without a model takes the first of the split screen models
+that player 1 and the players before them don't wear.
+=====================
+*/
+static const char *CL_PlayerUserinfo( qboolean *truncated ) {
+	static const char *const models[] = { "visor", "major", "grunt", "ranger", "slash" };
+	static char info[ MAX_INFO_STRING * 2 ];
+	char taken[ MAX_LOCAL_PLAYERS ][ MAX_QPATH ];
+	const char *name, *model;
+	int player, i, j;
+
+	Q_strncpyz( info, Cvar_InfoString( CVAR_USERINFO, truncated ), sizeof( info ) );
+	if ( cl_localPlayer == 0 ) {
+		return info;
+	}
+
+	// the models of player 1 and the players before this one
+	Q_strncpyz( taken[ 0 ], Cvar_VariableString( "model" ), sizeof( taken[ 0 ] ) );
+	for ( player = 1; player <= cl_localPlayer; player++ ) {
+		model = Cvar_VariableString( va( "cl_splitModel%i", player + 1 ) );
+		for ( i = 0; *model == '\0' && i < ARRAY_LEN( models ); i++ ) {
+			for ( j = 0; j < player && Q_stricmpn( taken[ j ], models[ i ], strlen( models[ i ] ) ); j++ )
+				;
+			if ( j == player ) {
+				model = models[ i ];
+			}
+		}
+		Q_strncpyz( taken[ player ], *model ? model : "visor", sizeof( taken[ player ] ) );
+	}
 
+	name = Cvar_VariableString( va( "cl_splitName%i", cl_localPlayer + 1 ) );
+	Info_SetValueForKey_s( info, MAX_USERINFO_LENGTH, "name", *name ? name : va( "Player %i", cl_localPlayer + 1 ) );
+	Info_SetValueForKey_s( info, MAX_USERINFO_LENGTH, "model", taken[ cl_localPlayer ] );
+	Info_SetValueForKey_s( info, MAX_USERINFO_LENGTH, "headmodel", taken[ cl_localPlayer ] );
+	Info_SetValueForKey_s( info, MAX_USERINFO_LENGTH, "team_model", taken[ cl_localPlayer ] );
+	Info_SetValueForKey_s( info, MAX_USERINFO_LENGTH, "team_headmodel", taken[ cl_localPlayer ] );
+
+	return info;
+}
