+// PS5: split screen. Where each key another local player holds went down: to their
+// binding in play, or to the menus and console everyone shares.
+typedef enum {
+	PLAYER_KEY_UP,
+	PLAYER_KEY_BOUND,
+	PLAYER_KEY_SHARED
+} playerKey_t;
+
+static byte playerKeys[ MAX_LOCAL_PLAYERS ][ MAX_KEYS ];
+
