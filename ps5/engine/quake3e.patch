+/*
+===================
+CL_PlayerBinding
+
+PS5: split screen. Another local player's binding for a key (they share player
+1's bindings), as Key_ParseBinding, each command run as theirs (CL_Player_f).
+===================
+*/
+static void CL_PlayerBinding( int player, int key, qboolean down, unsigned time )
+{
+	char buf[ MAX_STRING_CHARS ], *p, *end;
+
+	if( !keys[key].binding || keys[key].binding[0] == '\0' )
+		return;
+
+	p = buf;
+
+	Q_strncpyz( buf, keys[key].binding, sizeof( buf ) );
+
+	while( 1 )
+	{
+		while ( isspace( *p ) )
+			p++;
+		end = strchr( p, ';' );
+		if ( end )
+			*end = '\0';
+		if ( *p == '+' )
+		{
+			// button commands add keynum and time as parameters
+			Cbuf_AddText( va( "player %i %c%s %d %d\n", player + 1, ( down ) ? '+' : '-', p + 1, key, time ) );
+		}
+		else if ( down && *p )
+		{
+			// normal commands only execute on key press
+			Cbuf_AddText( va( "player %i %s\n", player + 1, p ) );
+		}
+		if( !end )
+			break;
+		p = end + 1;
+	}
+}
