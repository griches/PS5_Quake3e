+/*
+===================
+CL_PlayerKeyEvent
+
+PS5: split screen. Another local player's key. In play it does what it is
+bound to, for them; in a menu, the console or a chat line (everyone's) it is
+player 1's key, and so is ESCAPE (OPTIONS: the menu). A key that went down for
+one goes up for it. A player without a part of the screen has no keys.
+===================
+*/
+void CL_PlayerKeyEvent( int player, int key, qboolean down, unsigned time )
+{
+	byte *state;
+
+	if ( (unsigned)player >= MAX_LOCAL_PLAYERS || (unsigned)key >= MAX_KEYS ) {
+		return;
+	}
+
+	state = &playerKeys[ player ][ key ];
+
+	if ( !down ) {
+		if ( *state == PLAYER_KEY_BOUND ) {
+			CL_PlayerBinding( player, key, qfalse, time );
+		} else if ( *state == PLAYER_KEY_SHARED ) {
+			CL_KeyEvent( key, qfalse, time );
+		}
+		*state = PLAYER_KEY_UP;
+		return;
+	}
+
+	if ( *state != PLAYER_KEY_UP || player >= CL_SplitViews() ) {
+		return;
+	}
+
+	if ( Key_GetCatcher() || key == K_ESCAPE ) {
+		*state = PLAYER_KEY_SHARED;
+		CL_KeyEvent( key, qtrue, time );
+	} else if ( CL_PlayerPlaying( player ) ) {
+		*state = PLAYER_KEY_BOUND;
+		CL_PlayerBinding( player, key, qtrue, time );
+	}
 }
 
 
